POSTGRES_USER=safebase_user
POSTGRES_PASSWORD=safebase_password
POSTGRES_DB=safebase_db
CLIENT_DB_USER=client_user
CLIENT_DB_PASSWORD=client_password
CLIENT_DB_NAME=client_db
JWT_SECRET=change_me
VITE_API_URL=http://localhost:3000
# Sauvegardes planifiées (format cron, vide = désactivé) : ici tous les jours à 3h00
BACKUP_CRON=0 3 * * *
# Nombre de sauvegardes horodatées conservées par base (0 = tout garder)
BACKUP_RETENTION=7
