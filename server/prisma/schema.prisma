datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  password  String
  createdAt DateTime        @default(now())
  backups   BackupHistory[]
}

model BackupHistory {
  id        String   @id @default(uuid())
  dbName    String
  fileName  String
  date      String
  status    String
  createdAt DateTime @default(now())
  
  // null pour une sauvegarde planifiée (lancée par le cron, sans utilisateur)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}